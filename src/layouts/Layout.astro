---
import "../styles/Base.scss";
import Navbar from "../components/navbar/Navbar";
import Footer from "../components/footer/Footer.astro";
import ModalShare from "../components/general/ModalShare";
import { CheckEventsUser } from "../components/general/check-events-user";
import { CheckUserLogin } from "../components/general/check-user-login";

import "@fontsource/playfair-display";
import "@fontsource/bitter";
import "@fontsource/roboto";
import "@fontsource/inter";
import { GetInformation } from "../api/ApiGetInformation";

interface Props {
  title: string;
}

const { title } = Astro.props;

const { data } = await GetInformation({ url: "footer?populate[social_media][populate][logo][fields]=url" });
const { data: data_navbar } = await GetInformation({ url: "navbar?populate=*" });
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='description'
      content='Discover extraordinary music events in Seattle with the SAMA Calendar. From concerts to cultural showcases, find experiences for every music lover. Start exploring today!'
    />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='icon' href='/favicon.ico' />
    <meta name='generator' content={Astro.generator} />
    <title>SAMA Seattle Calendar - Explore Unique Music Events</title>

    <script>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-W4RS3FVP");
    </script>

    <script type='text/javascript' src='//script.crazyegg.com/pages/scripts/0121/9046.js' async='async'></script>
  </head>
  <body>
    <div id='page-loader'>
      <div class='page-loader-spinner'></div>
    </div>

    <noscript><iframe src='https://www.googletagmanager.com/ns.html?id=GTM-W4RS3FVP' height='0' width='0' style='display:none;visibility:hidden'></iframe></noscript>

    <Navbar client:only='react' data={data_navbar} />
    <ModalShare client:idle />
    <slot />
    <Footer data={data} />
    <CheckEventsUser client:only='react' />
    <CheckUserLogin client:load />

    <script>
      window.addEventListener("load", () => {
        const loader = document.getElementById("page-loader");
        if (loader) {
          loader.classList.add("hidden");
          setTimeout(() => loader.remove(), 400);
        }
      });
    </script>
  </body>
</html>
