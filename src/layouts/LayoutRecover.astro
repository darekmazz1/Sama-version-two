---
import SvgLogo from "../svg/SvgLogo";
---

<div class='bg-cover bg-top relative bg-no-repeat pt-[120px] md:pt-0' style={{ backgroundImage: "url(/assets/bg_home_t.jpg)" }}>
  <div class='container_all min-h-[80vh] flex justify-center flex-col font-playfair text-white md:flex-row md:items-center'>
    <div class='lg:w-1/2 md:w-[40%]'>
      <div class='w-[80%] md:w-[230px] lg:max-w-[276px] m-auto'>
        <SvgLogo client:idle />
      </div>
    </div>

    <div class='lg:w-1/2 md:w-[60%] md:px-[40px] lg:px-[90px] pt-[50px] md:pt-0'>
      <slot />
    </div>
  </div>
</div>
