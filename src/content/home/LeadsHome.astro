---
import Button from '../../components/buttons/Button';

const { data } = Astro.props;
const map_data = data?.data?.attributes;
---

<section class='bg-light_purple mt-[40px] md:mt-[80px] py-[40px] px-[24px] rounded-[24px]'>
  <p class='text-[36px] font-playfair max-w-[470px] md:leading-10'>{map_data?.newsletter_title}</p>
  <p class='mt-[40px] text-[24px] font-bitter max-w-[600px]'>{map_data?.newsletter_description}</p>

  <div class='md:flex md:gap-[40px] md:mt-[40px]'>
    <input class='bg-white text-black w-full p-[12px] text-[16px] mt-[40px] md:w-[350px] md:mt-0' placeholder='Email' type='email' />

    <div class='mt-[40px] md:mt-0'>
      <Button client:idle text='Sign up' style={null} />
    </div>
  </div>
</section>
