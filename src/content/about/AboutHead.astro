---
import { mapImage, parseText } from '../../utils/general';

const { data } = Astro.props;
const map_data = data?.data?.attributes;
---

<section>
  <div class='container_all md:flex gap-[32px] md:items-center'>
    <img
      class='w-full max-h-[240px] my-[40px] object-cover md:w-1/2 md:h-[384px] xl:h-[400px] md:max-h-[999px] md:my-0'
      src={mapImage(map_data?.image)}
      alt=''
    />
    <p
      class='text-white text-paragraph font-roboto md:w-1/2 md:max-h-[384px] xl:max-h-[400px] overflow-auto'
      set:html={parseText(map_data?.description)}
    />
  </div>
</section>
