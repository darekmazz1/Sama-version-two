---
import EventGallerySlider from '../../components/swiper/EventGallerySlider';
import { parseText } from '../../utils/general';

const { data } = Astro.props;
const map_data = data?.data?.attributes;
---

<section class='text-white'>
  <div class='container_all'>
    <h2 class='text-[32px] font-bitter text-center mt-[40px] md:mt-[80px] '>Image Gallery</h2>
    <p class='mt-[20px] text-center text-paragraph font-roboto' set:html={parseText(map_data?.gallery_description)} />

    <div class='mt-[48px] md:mt-[80px]'>
      <EventGallerySlider client:visible data={map_data} />
    </div>
  </div>
</section>
