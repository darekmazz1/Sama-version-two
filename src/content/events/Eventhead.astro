---
import Button from '../../components/buttons/Button';
import CustomNavigation from '../../components/general/CustomNavigation.astro';
import SvgClock from '../../svg/eventCard/SvgClock';
import SvgMapAim from '../../svg/eventCard/SvgMapAim';
import SvgArrow from '../../svg/news/SvgArrow';
import Mediator from '../../components/buttons/Mediator';
import { getDate, getDay, mapImage } from '../../utils/general';

const { data } = Astro.props;
const map_data = data?.data?.attributes;
---

<section>
  <div class='container_all'>
    <div class='md:flex'>
      <a href='/'>
        <div class='w-[35px] rotate-[180deg] translate-x-[-5px]'>
          <SvgArrow type={1} color={null} />
        </div>
      </a>

      <div class='hidden md:flex'>
        <CustomNavigation text='Home' hrf='/' arrow={true} />
        <CustomNavigation text='Calendar' hrf='/calendar' arrow={true} />
        <CustomNavigation text={map_data?.event_title} hrf='#' arrow={false} />
      </div>
    </div>
  </div>
  <div class='relative text-white mt-[16px]'>
    <div class='md:flex container_all_desktop md:gap-[58px] items-center'>
      <div class='relative h-[200px] md:h-[361px] w-full max-w-[600px]'>
        <img class='w-full h-full object-cover' src={mapImage(map_data?.image)} alt='' />
        <div
          class='bg-white text-black absolute top-[19px] left-[19px] py-[8px] px-[15px] font-[700] rounded-[6px] opacity-80 font-inter flex justify-center items-center flex-col'
        >
          <p class='text-[16px] uppercase'>{getDate(map_data?.date)}</p>
          <p class='text-[40px] leading-10'>{getDay(map_data?.date)}</p>
        </div>
      </div>

      <div class='container_all_mobil py-[42px] md:w-[50%] md:py-0 w-full flex-grow'>
        <h1 class='text-[36px] font-playfair'>{map_data?.event_title}</h1>

        <div class='flex mt-[34px] gap-[40px]'>
          <div class='flex justify-center items-start gap-[10px]'>
            <div class='w-[30px] flex-shrink-0'>
              <SvgClock />
            </div>
            <div class='flex-grow'>
              <p class='text-[12px] font-roboto'>START</p>
              <p class='text-[16px]'>{map_data?.start}</p>
            </div>
          </div>

          <div class='opacity-80'>
            <p class='text-[12px] font-roboto'>DOORS</p>
            <p class='text-[16px]'>{map_data?.doors}</p>
          </div>
        </div>

        <div class='flex justify-center items-start gap-[10px] mt-[16px]'>
          <div class='w-[30px] flex-shrink-0'>
            <SvgMapAim />
          </div>
          <div class='flex-grow'>
            <p class='text-[16px] uppercase font-inter'>{map_data?.venues}</p>
            <p class='text-[14px] opacity-80 font-inter font-[300]'>{map_data?.venues_address}</p>
          </div>
        </div>

        <div class='flex justify-between items-center mt-[16px] md:mt-[40px] md:justify-start md:gap-[40px]'>
          <Button text='Get Tickets' style={''} onClick={null} />
          <Mediator client:idle />
        </div>
      </div>
    </div>
  </div>
</section>
