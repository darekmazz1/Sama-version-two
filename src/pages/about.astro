---
import { GetInformation } from '../api/ApiGetInformation';
import Layout from '../layouts/Layout.astro';

import AboutHead from '../content/about/AboutHead.astro';
import AboutForm from '../content/about/AboutForm';
import HeadArrowAndLetter from '../components/general/HeadArrowAndLetter.astro';

const { data } = await GetInformation({ url: 'about?populate[image][fields]=url' });
---

<Layout title='about'>
  <main class='bg-dark_blue pt-[120px] md:pt-0'>
    <HeadArrowAndLetter text='About us' text_navigation="About us"/>
    <AboutHead data={data} />

    <div class='max-w-[768px] m-auto'>
      <AboutForm client:idle data={data} />
    </div>
  </main>
</Layout>
